-- Функция для копирования
local function copyToClipboard(text, scriptName)
    if setclipboard then
        setclipboard(text)
        Rayfield:Notify({ 
            Title = "✅ Скопировано!", 
            Content = scriptName .. " — ссылка в буфере. Вставь в Delta!", 
            Duration = 4 
        })
    else
        Rayfield:Notify({ 
            Title = "Ошибка", 
            Content = "Твой исполнитель не поддерживает копирование", 
            Duration = 3 
        })
    end
end

