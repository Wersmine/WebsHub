    Name = "WebsHub",
    LoadingTitle = "Загрузка...",
    LoadingSubtitle = "by Webs_My",
    ConfigurationSaving = { Enabled = false }
})

local MainTab = Window:CreateTab("Скрипты", 4483362458)

-- Функция для копирования в буфер
local function copyToClipboard(text, scriptName)
    if setclipboard then
        setclipboard(text)
        Rayfield:Notify({ 
            Title = "Скопировано!", 
            Content = scriptName .. " — ссылка в буфере. Вставь в Delta!", 
            Duration = 4 
        })
    else
        Rayfield:Notify({ 
            Title = "Ошибка", 
            Content = "Твой исполнитель не поддерживает копирование", 
            Duration = 3 
        })
    end
end

