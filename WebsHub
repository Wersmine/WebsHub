_G.StartDrone = function()
    DroneWindow = Rayfield:CreateWindow({
        Name = "FPV AutoFarm (Drone)",
        LoadingTitle = "Загрузка Дрона...",
        LoadingSubtitle = "by Webs_My",
        ConfigurationSaving = { Enabled = false }
    })

    -- Отдельная кнопка ТП (чтобы не мешала в меню)
    local D_ScreenGui = Instance.new("ScreenGui")
    D_ScreenGui.Name = "DroneTpBtn"
    D_ScreenGui.Parent = game.CoreGui
    D_ScreenGui.ResetOnSpawn = false

    local BOX_POS = Vector3.new(1919, 66, -401)

    local TpButton = Instance.new("TextButton")
    TpButton.Size = UDim2.new(0, 140, 0, 50)
    TpButton.Position = UDim2.new(0, 20, 0.4, 0)
    TpButton.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
    TpButton.TextColor3 = Color3.new(1, 1, 1)
    TpButton.Text = "📍 ТП К ЯЩИКУ"
    TpButton.TextSize = 14
    TpButton.Font = Enum.Font.GothamBold
    TpButton.Draggable = true
    TpButton.Parent = D_ScreenGui
    Instance.new("UICorner", TpButton).CornerRadius = UDim.new(0, 10)

    TpButton.MouseButton1Click:Connect(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(BOX_POS)
            TpButton.Text = "✅ ТП!"
            task.wait(1)
            TpButton.Text = "📍 ТП К ЯЩИКУ"
        end
    end)

    -- Основные настройки Дрона
    local D_MainTab = DroneWindow:CreateTab("Автофарм", 4483362458)
    local D_SettingsTab = DroneWindow:CreateTab("Настройки", 4483362458)

    local autoFarmEnabled = false
    local killNPCs = true
    local killPlayers = true

    local function click()
        if mouse1click then pcall(mouse1click) end
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new(
                workspace.CurrentCamera.ViewportSize.X / 2,
                workspace.CurrentCamera.ViewportSize.Y / 2
            ))
        end)
    end

    local function spamClick(count, delay)
        count = count or 8
        delay = delay or 0.15
        for i = 1, count do
            click()
            task.wait(delay)
        end
    end

    local function clickToBattle()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return false end
        for _, gui in pairs(playerGui:GetDescendants()) do
            if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                local text = (gui.Text or ""):lower()
                if text:find("battle") or text:find("в бой") 
                   or text:find("играть") or text:find("play")
                   or text:find("continue") then
                    pcall(function() gui:Activate() end)
                    local pos = gui.AbsolutePosition
                    local size = gui.AbsoluteSize
                    pcall(function()
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton1(Vector2.new(
                            pos.X + size.X/2, pos.Y + size.Y/2
                        ))
                    end)
                    return true
                end
            end
        end
        return false
    end

    local function getMyDrone()
        return workspace:FindFirstChild(LocalPlayer.Name .. "_FPVDrone")
    end

    local function getClosestPlayer()
        local char = LocalPlayer.Character
        if not char then return nil end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local myPos = hrp.Position
        local closest, closestDist = nil, math.huge
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = plr.Character:FindFirstChild("HumanoidRootPart")
                        or plr.Character:FindFirstChild("Head")
                    if part then
                        local dist = (part.Position - myPos).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closest = plr.Character
                        end
                    end
                end
            end
        end
        return closest
    end

    local function getClosestNPC()
        local char = LocalPlayer.Character
        if not char then return nil end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local myPos = hrp.Position
        local closest, closestDist = nil, math.huge
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj.Name:find("EnemyNPC") then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                    if part then
                        local dist = (part.Position - myPos).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closest = obj
                        end
                    end
                end
            end
        end
        return closest
    end

    local function getClosestTarget()
        if killPlayers then
            local p = getClosestPlayer()
            if p then return p end
        end
        if killNPCs then
            local n = getClosestNPC()
            if n then return n end
        end
        return nil
    end

    -- Логика работы
    RunService.Heartbeat:Connect(function()
        if not autoFarmEnabled then return end
        local drone = getMyDrone()
        if not drone then return end
        local target = getClosestTarget()
        if not target then return end
        local hrp = target:FindFirstChild("HumanoidRootPart")
        if not hrp then hrp = target:FindFirstChild("Head") or target:FindFirstChildWhichIsA("BasePart") end
        if not hrp then return end
        local feetPos = hrp.Position - Vector3.new(0, 2, 0)
        pcall(function() drone:PivotTo(CFrame.new(feetPos)) end)
    end)

    task.spawn(function()
        while task.wait(5) do
            if autoFarmEnabled then
                local char = LocalPlayer.Character
                if not char or (char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health <= 0) then
                    clickToBattle()
                else
                    char.HumanoidRootPart.CFrame = CFrame.new(BOX_POS)
                    task.wait(0.5)
                    workspace.CurrentCamera.CFrame = CFrame.new(BOX_POS + Vector3.new(0, 10, 0), BOX_POS)
                    task.wait(0.5)
                    spamClick(8, 0.15)
                end
            end
        end
    end)

    -- Интерфейс
    D_MainTab:CreateSection("Управление")
    D_MainTab:CreateToggle({ Name = "🤖 ПОЛНЫЙ АВТОФАРМ", CurrentValue = false,
        Callback = function(s)
            autoFarmEnabled = s
            Rayfield:Notify({ Title = "Дрон", Content = s and "Автофарм включен" or "Автофарм выключен", Duration = 3 })
        end 
    })

    D_SettingsTab:CreateSection("Цели")
    D_SettingsTab:CreateToggle({ Name = "👤 Игроки", CurrentValue = true, Callback = function(s) killPlayers = s end })
    D_SettingsTab:CreateToggle({ Name = "🎯 NPC", CurrentValue = true, Callback = function(s) killNPCs = s end })

    D_MainTab:CreateSection("Ручное")
    D_MainTab:CreateButton({ Name = "🖱️ Тест клика", Callback = function() spamClick(5, 0.2) end })
    D_MainTab:CreateButton({ Name = "🎮 'To battle!'", Callback = function() clickToBattle() end })

    D_SettingsTab:CreateSection("Кнопка на экране")
    D_SettingsTab:CreateToggle({ Name = "👁️ Показать кнопку ТП", CurrentValue = true, Callback = function(s) TpButton.Visible = s end })
end
