_G.StartUniversal = function()
    UniversalWindow = Rayfield:CreateWindow({
        Name = "Webs_My v4 (Universal)",
        LoadingTitle = "Загрузка Универсала...",
        LoadingSubtitle = "by Webs_My",
        ConfigurationSaving = { Enabled = false }
    })

    -- HUD
    local U_ScreenGui = Instance.new("ScreenGui")
    U_ScreenGui.Parent = game.CoreGui
    U_ScreenGui.Name = "UniHUD"
    U_ScreenGui.ResetOnSpawn = false

    local U_HudFrame = Instance.new("Frame")
    U_HudFrame.Size = UDim2.new(0, 260, 0, 56)
    U_HudFrame.Position = UDim2.new(0, 10, 0, 100)
    U_HudFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    U_HudFrame.BackgroundTransparency = 0.25
    U_HudFrame.BorderSizePixel = 0
    U_HudFrame.Parent = U_ScreenGui
    Instance.new("UICorner", U_HudFrame).CornerRadius = UDim.new(0, 8)

    local U_CoordsText = Instance.new("TextLabel")
    U_CoordsText.Size = UDim2.new(1, 0, 0.6, 0)
    U_CoordsText.BackgroundTransparency = 1
    U_CoordsText.TextColor3 = Color3.fromRGB(0, 255, 120)
    U_CoordsText.Font = Enum.Font.Code
    U_CoordsText.TextSize = 14
    U_CoordsText.Text = "X: 0  Y: 0  Z: 0"
    U_CoordsText.Parent = U_HudFrame

    local U_FpsText = Instance.new("TextLabel")
    U_FpsText.Size = UDim2.new(1, 0, 0.4, 0)
    U_FpsText.Position = UDim2.new(0, 0, 0.6, 0)
    U_FpsText.BackgroundTransparency = 1
    U_FpsText.TextColor3 = Color3.fromRGB(255, 200, 60)
    U_FpsText.Font = Enum.Font.Code
    U_FpsText.TextSize = 13
    U_FpsText.Text = "FPS: —  Ping: —"
    U_FpsText.Parent = U_HudFrame

    local u_fpsCount, u_fpsTime = 0, tick()
    task.spawn(function()
        while task.wait(0.1) do
            if not U_ScreenGui.Parent then break end
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local p = char.HumanoidRootPart.Position
                U_CoordsText.Text = "X: " .. math.floor(p.X) .. "  Y: " .. math.floor(p.Y) .. "  Z: " .. math.floor(p.Z)
            end
            u_fpsCount = u_fpsCount + 1
            if tick() - u_fpsTime >= 1 then
                local ping = "—"
                pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
                U_FpsText.Text = "FPS: " .. u_fpsCount .. "  Ping: " .. ping
                u_fpsCount, u_fpsTime = 0, tick()
            end
        end
    end)
    RunService.RenderStepped:Connect(function() u_fpsCount = u_fpsCount + 1 end)

    -- Вкладки
    local MainTab = UniversalWindow:CreateTab("Main", 4483362458)
    local MoveTab = UniversalWindow:CreateTab("Movement", 4483362458)
    local EspTab = UniversalWindow:CreateTab("ESP", 4483362458)
    local AimTab = UniversalWindow:CreateTab("Aimbot", 4483362458)
    local PlrTab = UniversalWindow:CreateTab("Players", 4483362458)
    local RageTab = UniversalWindow:CreateTab("Rage", 4483362458)

    -- MAIN
    MainTab:CreateSection("Персонаж")
    local walkSpeed = 16
    local jumpPower = 50
    local spinEnabled = false
    local spinSpeed = 360

    local function applyStats(char)
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = walkSpeed
            hum.UseJumpPower = true
            hum.JumpPower = jumpPower
        end
    end

    MainTab:CreateSlider({ Name = "Скорость", Range = {16, 1000}, Increment = 1, CurrentValue = 16,
        Callback = function(v) walkSpeed = v; applyStats(LocalPlayer.Character) end })
    MainTab:CreateSlider({ Name = "Прыжок", Range = {50, 5000}, Increment = 5, CurrentValue = 50,
        Callback = function(v) jumpPower = v; applyStats(LocalPlayer.Character) end })
    MainTab:CreateToggle({ Name = "Spin", CurrentValue = false, Callback = function(s) spinEnabled = s end })

    RunService.Heartbeat:Connect(function(dt)
        if not spinEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(spinSpeed) * dt, 0)
    end)

    -- MOVEMENT
    MoveTab:CreateSection("Noclip")
    local noclipEnabled = false
    MoveTab:CreateToggle({ Name = "Noclip", CurrentValue = false, Callback = function(s) noclipEnabled = s end })
    RunService.Stepped:Connect(function()
        if not noclipEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BasePart") then obj.CanCollide = false end
        end
    end)

    MoveTab:CreateSection("Полёт")
    local flyEnabled = false
    local flySpeed = 50
    local flyBV = nil
    MoveTab:CreateSlider({ Name = "Скорость полёта", Range = {10, 500}, Increment = 5, CurrentValue = 50, Callback = function(v) flySpeed = v end })
    MoveTab:CreateToggle({ Name = "Включить полёт", CurrentValue = false, Callback = function(state)
        flyEnabled = state
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if state then
            flyBV = Instance.new("BodyVelocity")
            flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            flyBV.Parent = hrp
        elseif flyBV then
            flyBV:Destroy()
            flyBV = nil
        end
    end })

    RunService.RenderStepped:Connect(function()
        if not flyEnabled or not flyBV then return end
        local cam = workspace.CurrentCamera
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local move = hum.MoveDirection
        local camLook = cam.CFrame.LookVector
        flyBV.Velocity = camLook * move.Z * flySpeed + cam.CFrame.RightVector * move.X * flySpeed
    end)

    -- ESP
    EspTab:CreateSection("ESP")
    local espBox = false
    local espObjects = {}
    local function updateESP()
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local char = plr.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        if espBox and not espObjects[plr] then
                            local box = Instance.new("BoxHandleAdornment")
                            box.Size = Vector3.new(3, 5.4, 3)
                            box.Adornee = hrp
                            box.AlwaysOnTop = true
                            box.Color3 = Color3.fromRGB(255, 0, 0)
                            box.Parent = hrp
                            espObjects[plr] = box
                        elseif not espBox and espObjects[plr] then
                            espObjects[plr]:Destroy()
                            espObjects[plr] = nil
                        end
                    end
                end
            end
        end
    end
    EspTab:CreateToggle({ Name = "ESP Бокс", CurrentValue = false, Callback = function(s) espBox = s; updateESP() end })

    -- AIMBOT
    AimTab:CreateSection("Аимбот")
    local aimEnabled = false
    local aimSmooth = 0.3
    AimTab:CreateToggle({ Name = "Аимбот (камера)", CurrentValue = false, Callback = function(s) aimEnabled = s end })
    AimTab:CreateSlider({ Name = "Плавность", Range = {0.02, 1}, Increment = 0.02, CurrentValue = 0.3, Callback = function(v) aimSmooth = v end })

    RunService:BindToRenderStep("AimbotCamera", Enum.RenderPriority.Camera.Value + 1, function()
        if not aimEnabled then return end
        local cam = workspace.CurrentCamera
        local closest, shortest = nil, 300
        local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local head = plr.Character:FindFirstChild("Head")
                if head then
                    local sp, on = cam:WorldToViewportPoint(head.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if d < shortest then shortest = d; closest = head end
                    end
                end
            end
        end
        if closest then
            cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, closest.Position), aimSmooth)
        end
    end)

    -- PLAYERS
    PlrTab:CreateSection("Действия")
    local selectedPlayer = nil
    local function getNames()
        local n = {}
        for _, p in pairs(Players:GetPlayers()) do if p ~= LocalPlayer then table.insert(n, p.Name) end end
        return n
    end
    local drop = PlrTab:CreateDropdown({ Name = "Игрок", Options = getNames(), CurrentOption = {},
        Callback = function(opt) if #opt > 0 then selectedPlayer = Players:FindFirstChild(opt[1]) end end })

    PlrTab:CreateButton({ Name = "🎣 Притянуть ко мне", Callback = function()
        if not selectedPlayer or not selectedPlayer.Character then return end
        local char = LocalPlayer.Character
        if not char then return end
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        local tHrp = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myHrp and tHrp then
            local bp = Instance.new("BodyPosition")
            bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bp.P = 50000; bp.D = 1000
            bp.Position = myHrp.Position + Vector3.new(0, 0, -3)
            bp.Parent = tHrp
            task.delay(3, function() if bp then bp:Destroy() end end)
        end
    end })

    PlrTab:CreateButton({ Name = "💀 Убить", Callback = function()
        if not selectedPlayer or not selectedPlayer.Character then return end
        local hum = selectedPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum.Health = 0 end) end
    end })

    -- RAGE (Невидимость)
    RageTab:CreateSection("Защита")
    local invisibleEnabled = false
    local function applyInvis(state)
        local char = LocalPlayer.Character
        if not char then return end
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BasePart") then obj.Transparency = state and 1 or 0 end
        end
    end
    RageTab:CreateToggle({ Name = "Невидимость", CurrentValue = false, Callback = function(s) invisibleEnabled = s; applyInvis(s) end })
    task.spawn(function()
        while task.wait(0.1) do if invisibleEnabled then applyInvis(true) end end
    end)

    LocalPlayer.CharacterAdded:Connect(function(char) task.wait(0.5); applyStats(char) end)
    if LocalPlayer.Character then applyStats(LocalPlayer.Character) end
end
