local function StartDrone()
    DroneWindow = Rayfield:CreateWindow({
        Name = "FPV Drone",
        LoadingTitle = "Загрузка...",
        LoadingSubtitle = "by Webs_My",
        ConfigurationSaving = { Enabled = false }
    })

    local BOX_POS = Vector3.new(1919, 66, -401)
    local TpBtn = Instance.new("TextButton", game:GetService("CoreGui"))
    TpBtn.Size = UDim2.new(0, 140, 0, 50)
    TpBtn.Position = UDim2.new(0, 20, 0.4, 0)
    TpBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
    TpBtn.Text = "📍 ТП К ЯЩИКУ"
    TpBtn.TextColor3 = Color3.new(1, 1, 1)
    TpBtn.Draggable = true
    Instance.new("UICorner", TpBtn).CornerRadius = UDim.new(0, 10)
    TpBtn.MouseButton1Click:Connect(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(BOX_POS)
        end
    end)

    local Main = DroneWindow:CreateTab("Дрон", 4483362458)
    local autoFarmEnabled = false
    local killNPCs = true
    local killPlayers = true

    local function click()
        if mouse1click then pcall(mouse1click) end
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new(
                workspace.CurrentCamera.ViewportSize.X / 2,
                workspace.CurrentCamera.ViewportSize.Y / 2
            ))
        end)
    end

    local function spamClick(count, delay)
        count = count or 8
        delay = delay or 0.15
        for i = 1, count do
            click()
            task.wait(delay)
        end
    end

    local function getMyDrone()
        return workspace:FindFirstChild(LocalPlayer.Name .. "_FPVDrone")
    end

    local function getClosestTarget()
        local char = LocalPlayer.Character
        if not char then return nil end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local myPos = hrp.Position
        local closest, closestDist = nil, math.huge

        if killPlayers then
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local part = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Head")
                        if part then
                            local dist = (part.Position - myPos).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closest = plr.Character
                            end
                        end
                    end
                end
            end
        end

        if killNPCs then
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj.Name:find("EnemyNPC") then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                        if part then
                            local dist = (part.Position - myPos).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closest = obj
                            end
                        end
                    end
                end
            end
        end
        return closest
    end

    RunService.Heartbeat:Connect(function()
        if not autoFarmEnabled then return end
        local drone = getMyDrone()
        if not drone then return end
        local target = getClosestTarget()
        if not target then return end
        local hrp = target:FindFirstChild("HumanoidRootPart")
        if not hrp then hrp = target:FindFirstChild("Head") or target:FindFirstChildWhichIsA("BasePart") end
        if not hrp then return end
        local feetPos = hrp.Position - Vector3.new(0, 2, 0)
        pcall(function() drone:PivotTo(CFrame.new(feetPos)) end)
    end)

    task.spawn(function()
        while task.wait(5) do
            if autoFarmEnabled then
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    char.HumanoidRootPart.CFrame = CFrame.new(BOX_POS)
                    task.wait(0.5)
                    workspace.CurrentCamera.CFrame = CFrame.new(BOX_POS + Vector3.new(0, 10, 0), BOX_POS)
                    task.wait(0.5)
                    spamClick(8, 0.15)
                end
            end
        end
    end)

    Main:CreateToggle({ Name = "🤖 АВТОФАРМ", CurrentValue = false, Callback = function(s) autoFarmEnabled = s end })
    Main:CreateToggle({ Name = "👤 Игроки", CurrentValue = true, Callback = function(s) killPlayers = s end })
    Main:CreateToggle({ Name = "🎯 NPC", CurrentValue = true, Callback = function(s) killNPCs = s end })
    Main:CreateButton({ Name = "🖱️ Тест клика", Callback = function() spamClick(5, 0.2) end })
end

