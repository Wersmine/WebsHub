local function StartUniversal()
    UniversalWindow = Rayfield:CreateWindow({Name = "Webs_My v4", LoadingTitle = "Загрузка...", LoadingSubtitle = "by Webs_My", ConfigurationSaving = { Enabled = false }})
    
    -- HUD
    local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
    ScreenGui.Name = "WebsHUD" ScreenGui.ResetOnSpawn = false
    local HudFrame = Instance.new("Frame", ScreenGui)
    HudFrame.Size = UDim2.new(0, 260, 0, 56) HudFrame.Position = UDim2.new(0, 10, 0, 100)
    HudFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15) HudFrame.BackgroundTransparency = 0.25 HudFrame.BorderSizePixel = 0
    Instance.new("UICorner", HudFrame).CornerRadius = UDim.new(0, 8)
    local CoordsText = Instance.new("TextLabel", HudFrame)
    CoordsText.Size = UDim2.new(1, 0, 0.6, 0) CoordsText.BackgroundTransparency = 1 CoordsText.TextColor3 = Color3.fromRGB(0, 255, 120) CoordsText.Font = Enum.Font.Code CoordsText.TextSize = 14 CoordsText.Text = "X: 0  Y: 0  Z: 0"
    local FpsText = Instance.new("TextLabel", HudFrame)
    FpsText.Size = UDim2.new(1, 0, 0.4, 0) FpsText.Position = UDim2.new(0, 0, 0.6, 0) FpsText.BackgroundTransparency = 1 FpsText.TextColor3 = Color3.fromRGB(255, 200, 60) FpsText.Font = Enum.Font.Code FpsText.TextSize = 13 FpsText.Text = "FPS: —  Ping: —"
    
    local fpsCount, fpsTime = 0, tick()
    task.spawn(function()
        while task.wait(0.1) do
            if not ScreenGui.Parent then break end
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local p = char.HumanoidRootPart.Position
                CoordsText.Text = "X: " .. math.floor(p.X) .. "  Y: " .. math.floor(p.Y) .. "  Z: " .. math.floor(p.Z)
            end
            fpsCount = fpsCount + 1
            if tick() - fpsTime >= 1 then
                local ping = "—" pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
                FpsText.Text = "FPS: " .. fpsCount .. "  Ping: " .. ping
                fpsCount, fpsTime = 0, tick()
            end
        end
    end)
    RunService.RenderStepped:Connect(function() fpsCount = fpsCount + 1 end)

    local MainTab = UniversalWindow:CreateTab("Main", 4483362458)
    local MoveTab = UniversalWindow:CreateTab("Movement", 4483362458)
    local EspTab = UniversalWindow:CreateTab("ESP", 4483362458)
    local AimTab = UniversalWindow:CreateTab("Aimbot", 4483362458)
    local PlrTab = UniversalWindow:CreateTab("Players", 4483362458)
    local RageTab = UniversalWindow:CreateTab("Rage", 4483362458)

    -- Main
    MainTab:CreateSection("Персонаж")
    local walkSpeed = 16 local jumpPower = 50
    local function applyStats(char) if not char then return end local hum = char:FindFirstChildOfClass("Humanoid") if hum then hum.WalkSpeed = walkSpeed hum.UseJumpPower = true hum.JumpPower = jumpPower end end
    MainTab:CreateSlider({ Name = "Скорость", Range = {16, 1000}, Increment = 1, CurrentValue = 16, Callback = function(v) walkSpeed = v; applyStats(LocalPlayer.Character) end })
    MainTab:CreateSlider({ Name = "Высота прыжка", Range = {50, 5000}, Increment = 5, CurrentValue = 50, Callback = function(v) jumpPower = v; applyStats(LocalPlayer.Character) end })

    -- Movement (Fly & Noclip)
    MoveTab:CreateSection("Noclip")
    local noclipEnabled = false
    MoveTab:CreateToggle({ Name = "Noclip", CurrentValue = false, Callback = function(state) noclipEnabled = state local char = LocalPlayer.Character if char and not state then for _, obj in pairs(char:GetDescendants()) do if obj:IsA("BasePart") then obj.CanCollide = true end end end end })
    RunService.Stepped:Connect(function() if not noclipEnabled then return end local char = LocalPlayer.Character if not char then return end local hrp = char:FindFirstChild("HumanoidRootPart") for _, obj in pairs(char:GetDescendants()) do if obj:IsA("BasePart") and obj ~= hrp then obj.CanCollide = false end end end)
    
    MoveTab:CreateSection("Полёт")
    local flyEnabled = false local flySpeed = 50 local flyBV = nil local currentVel = Vector3.new(0, 0, 0)
    MoveTab:CreateSlider({ Name = "Скорость полёта", Range = {10, 500}, Increment = 5, CurrentValue = 50, Callback = function(v) flySpeed = v end })
    MoveTab:CreateToggle({ Name = "Полёт (Fly)", CurrentValue = false, Callback = function(state)
        flyEnabled = state
        local char = LocalPlayer.Character if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart") if not hrp then return end
        if state then
            currentVel = Vector3.new(0, 0, 0)
            flyBV = Instance.new("BodyVelocity") flyBV.Name = "FlyBV" flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6) flyBV.Velocity = Vector3.new(0, 0, 0) flyBV.Parent = hrp
        else
            if flyBV then flyBV:Destroy() flyBV = nil end
            local bv = hrp:FindFirstChild("FlyBV") if bv then bv:Destroy() end
        end
    end })
    RunService.RenderStepped:Connect(function(dt)
        if not flyEnabled then return end
        local cam = workspace.CurrentCamera local char = LocalPlayer.Character if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid") local hrp = char:FindFirstChild("HumanoidRootPart") if not hrp then return end
        if not flyBV or not flyBV.Parent then flyBV = Instance.new("BodyVelocity") flyBV.Name = "FlyBV" flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6) flyBV.Parent = hrp end
        local move = hum and hum.MoveDirection or Vector3.new(0, 0, 0)
        local camLook = cam.CFrame.LookVector local camRight = cam.CFrame.RightVector
        local camForwardFlat = Vector3.new(camLook.X, 0, camLook.Z) if camForwardFlat.Magnitude > 0.01 then camForwardFlat = camForwardFlat.Unit end
        local targetVel = camLook * move:Dot(camForwardFlat) + camRight * move:Dot(camRight)
        if targetVel.Magnitude > 0.01 then targetVel = targetVel.Unit * flySpeed else targetVel = Vector3.new(0, 0, 0) end
        currentVel = currentVel:Lerp(targetVel, math.clamp(dt * 8, 0, 1)) flyBV.Velocity = currentVel
    end)

    -- ESP
    EspTab:CreateSection("ESP")
    local espBox = false local espObjects = {}
    local function updateAllESP()
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local char = plr.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        if espBox and not espObjects[plr] then
                            local box = Instance.new("BoxHandleAdornment") box.Size = Vector3.new(3, 5.4, 3) box.Adornee = hrp box.AlwaysOnTop = true box.Color3 = Color3.fromRGB(255, 0, 0) box.Transparency = 0.5 box.Parent = hrp espObjects[plr] = box
                        elseif not espBox and espObjects[plr] then espObjects[plr]:Destroy() espObjects[plr] = nil end
                    end
                end
            end
        end
    end
    EspTab:CreateToggle({ Name = "ESP Бокс", CurrentValue = false, Callback = function(s) espBox = s; updateAllESP() end })

    -- Aimbot
    AimTab:CreateSection("Аимбот")
    local aimEnabled = false local aimSmooth = 0.3
    AimTab:CreateToggle({ Name = "Аимбот", CurrentValue = false, Callback = function(s) aimEnabled = s end })
    AimTab:CreateSlider({ Name = "Плавность", Range = {0.02, 1}, Increment = 0.02, CurrentValue = 0.3, Callback = function(v) aimSmooth = v end })
    RunService:BindToRenderStep("AimCam", Enum.RenderPriority.Camera.Value + 1, function()
        if not aimEnabled then return end
        local cam = workspace.CurrentCamera local closest, shortest = nil, 300
        local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local head = plr.Character:FindFirstChild("Head")
                if head then
                    local sp, on = cam:WorldToViewportPoint(head.Position)
                    if on then local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude if d < shortest then shortest = d closest = head end end
                end
            end
        end
        if closest then cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, closest.Position), aimSmooth) end
    end)

    -- Players
    PlrTab:CreateSection("Действия")
    local selectedPlayer = nil
    local function getNames() local n = {} for _, p in pairs(Players:GetPlayers()) do if p ~= LocalPlayer then table.insert(n, p.Name) end end return n end
    local drop = PlrTab:CreateDropdown({ Name = "Игрок", Options = getNames(), CurrentOption = {}, Callback = function(opt) if #opt > 0 then selectedPlayer = Players:FindFirstChild(opt[1]) end end })
    PlrTab:CreateButton({ Name = "🎣 Притянуть", Callback = function()
        if not selectedPlayer or not selectedPlayer.Character then return end
        local char = LocalPlayer.Character if not char then return end
        local myHrp = char:FindFirstChild("HumanoidRootPart") local tHrp = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myHrp and tHrp then
            local bp = Instance.new("BodyPosition") bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge) bp.P = 50000 bp.D = 1000 bp.Position = myHrp.Position + Vector3.new(0, 0, -3) bp.Parent = tHrp
            task.delay(3, function() if bp then bp:Destroy() end end)
        end
    end })
    PlrTab:CreateButton({ Name = "💀 Убить", Callback = function() if selectedPlayer and selectedPlayer.Character then local hum = selectedPlayer.Character:FindFirstChildOfClass("Humanoid") if hum then pcall(function() hum.Health = 0 end) end end end })

    -- Rage (Невидимость)
    RageTab:CreateSection("Защита")
    local invisibleEnabled = false
    local function applyInvis(state) local char = LocalPlayer.Character if not char then return end for _, obj in pairs(char:GetDescendants()) do if obj:IsA("BasePart") then obj.Transparency = state and 1 or 0 end end end
    RageTab:CreateToggle({ Name = "Невидимость", CurrentValue = false, Callback = function(s) invisibleEnabled = s; applyInvis(s) end })
    task.spawn(function() while task.wait(0.1) do if invisibleEnabled then applyInvis(true) end end end)

    LocalPlayer.CharacterAdded:Connect(function(char) task.wait(0.5); applyStats(char) end)
    if LocalPlayer.Character then applyStats(LocalPlayer.Character) end
end

