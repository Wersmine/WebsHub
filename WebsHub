_G.StartChaos = function()
    ChaosWindow = Rayfield:CreateWindow({
        Name = "Chaos Script",
        LoadingTitle = "Загрузка Хаоса...",
        LoadingSubtitle = "by Webs_My",
        ConfigurationSaving = { Enabled = false }
    })

    local C_MainTab = ChaosWindow:CreateTab("Хаос", 4483362458)

    -- Состояние
    local flyEnabled = false
    local flySpeed = 200
    local flyBV = nil
    local currentVel = Vector3.new(0, 0, 0)
    
    local espBoxEnabled = false
    local espTracerEnabled = false
    local espObjects = {}
    local tracerLines = {}
    
    local LAUNCH_HEIGHT = 1000000000000 -- 1 триллион

    -- ПОЛЁТ
    local function cleanupFly()
        if flyBV then flyBV:Destroy() flyBV = nil end
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local bv = hrp:FindFirstChild("FlyBV")
                if bv then bv:Destroy() end
            end
        end
        currentVel = Vector3.new(0, 0, 0)
    end

    local function startFly()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        currentVel = Vector3.new(0, 0, 0)
        flyBV = Instance.new("BodyVelocity")
        flyBV.Name = "FlyBV"
        flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyBV.Velocity = Vector3.new(0, 0, 0)
        flyBV.Parent = hrp
    end

    RunService.RenderStepped:Connect(function(dt)
        if not flyEnabled then return end
        local cam = workspace.CurrentCamera
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if not flyBV or not flyBV.Parent then startFly() end

        local move = hum and hum.MoveDirection or Vector3.new(0, 0, 0)
        local camLook = cam.CFrame.LookVector
        local camRight = cam.CFrame.RightVector
        local camForwardFlat = Vector3.new(camLook.X, 0, camLook.Z)
        if camForwardFlat.Magnitude > 0.01 then camForwardFlat = camForwardFlat.Unit end

        local rightInput = move:Dot(camRight)
        local forwardInput = move:Dot(camForwardFlat)
        local targetVel = camLook * forwardInput + camRight * rightInput
        
        if targetVel.Magnitude > 0.01 then
            targetVel = targetVel.Unit * flySpeed
        else
            targetVel = Vector3.new(0, 0, 0)
        end

        currentVel = currentVel:Lerp(targetVel, math.clamp(dt * 8, 0, 1))
        flyBV.Velocity = currentVel
    end)

    -- ESP
    local function clearESP(plr)
        if espObjects[plr] then
            for _, obj in pairs(espObjects[plr]) do if obj then obj:Destroy() end end
            espObjects[plr] = nil
        end
        if tracerLines[plr] then
            pcall(function() tracerLines[plr]:Remove() end)
            tracerLines[plr] = nil
        end
    end

    local function createESP(plr)
        clearESP(plr)
        espObjects[plr] = {}
        local char = plr.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if espBoxEnabled then
            local box = Instance.new("BoxHandleAdornment")
            box.Name = "ChaosBox"
            box.Size = Vector3.new(3, 5.4, 3)
            box.Adornee = hrp
            box.AlwaysOnTop = true
            box.ZIndex = 5
            box.Transparency = 0.5
            box.Color3 = Color3.fromRGB(255, 0, 0)
            box.Parent = hrp
            table.insert(espObjects[plr], box)
        end
    end

    local function refreshAllESP()
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then createESP(plr) end
        end
    end

    RunService.RenderStepped:Connect(function()
        if not espTracerEnabled then return end
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                if Drawing then
                    if not tracerLines[plr] then
                        local line = Drawing.new("Line")
                        line.Thickness = 2
                        line.Color = Color3.fromRGB(255, 255, 0)
                        line.Transparency = 1
                        line.Visible = false
                        tracerLines[plr] = line
                    end
                    local line = tracerLines[plr]
                    local char = plr.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local cam = workspace.CurrentCamera
                        local pos, onScreen = cam:WorldToViewportPoint(char.HumanoidRootPart.Position)
                        if onScreen then
                            line.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                            line.To = Vector2.new(pos.X, pos.Y)
                            line.Visible = true
                        else
                            line.Visible = false
                        end
                    else
                        line.Visible = false
                    end
                end
            end
        end
    end)

    Players.PlayerAdded:Connect(function(plr) task.wait(1); createESP(plr) end)
    Players.PlayerRemoving:Connect(function(plr) clearESP(plr) end)

    -- ПОДБРОС
    local function launchAll()
        local count = 0
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local char = plr.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local newPos = Vector3.new(hrp.Position.X, LAUNCH_HEIGHT, hrp.Position.Z)
                    pcall(function() char:PivotTo(CFrame.new(newPos)) end)
                    pcall(function() hrp.CFrame = CFrame.new(newPos) end)
                    pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
                    count = count + 1
                end
            end
        end
        return count
    end

    -- ИНТЕРФЕЙС
    C_MainTab:CreateSection("Активация хаоса")

    C_MainTab:CreateButton({
        Name = "💥 CHAOS MODE — ВКЛЮЧИТЬ ВСЁ",
        Callback = function()
            flyEnabled = true
            startFly()
            espBoxEnabled = true
            refreshAllESP()
            espTracerEnabled = true
            local n = launchAll()
            Rayfield:Notify({
                Title = "💥 CHAOS MODE",
                Content = "Полёт 200 + ESP + " .. n .. " игроков на 1 триллион!",
                Duration = 4
            })
        end
    })

    C_MainTab:CreateButton({
        Name = "🛑 Остановить хаос",
        Callback = function()
            flyEnabled = false
            cleanupFly()
            espBoxEnabled = false
            espTracerEnabled = false
            for _, plr in pairs(Players:GetPlayers()) do
                clearESP(plr)
            end
            Rayfield:Notify({ Title = "Chaos", Content = "Остановлено", Duration = 2 })
        end
    })

    -- ТЕСТ НА СЕБЕ
    C_MainTab:CreateSection("Тест на себе")

    C_MainTab:CreateButton({
        Name = "🧪 Подбросить СЕБЯ на 1 триллион",
        Callback = function()
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local newPos = Vector3.new(hrp.Position.X, LAUNCH_HEIGHT, hrp.Position.Z)
            pcall(function() char:PivotTo(CFrame.new(newPos)) end)
            pcall(function() hrp.CFrame = CFrame.new(newPos) end)
            pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
            Rayfield:Notify({ Title = "🧪 Тест", Content = "Ты отправлен на 1 триллион!", Duration = 3 })
        end
    })

    C_MainTab:CreateButton({
        Name = "🧪 CHAOS на СЕБЕ (полёт + подброс)",
        Callback = function()
            flyEnabled = true
            startFly()
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local newPos = Vector3.new(hrp.Position.X, LAUNCH_HEIGHT, hrp.Position.Z)
                    pcall(function() char:PivotTo(CFrame.new(newPos)) end)
                    pcall(function() hrp.CFrame = CFrame.new(newPos) end)
                    pcall(function() hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
                end
            end
            Rayfield:Notify({ Title = "🧪 CHAOS на себе", Content = "Полёт + подброс себя!", Duration = 3 })
        end
    })

    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(0.5)
        if flyEnabled then startFly() end
    end)
end
