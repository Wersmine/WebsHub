-- WEBSHUB ALL-IN-ONE
-- Часть 5: A Long Flight (v6)
-- ============================================

_G.StartFlight = function()
    FlightWindow = Rayfield:CreateWindow({
        Name = "A Long Flight",
        LoadingTitle = "Загрузка A Long Flight...",
        LoadingSubtitle = "by Webs_My",
        ConfigurationSaving = { Enabled = false }
    })

    local F_MainTab = FlightWindow:CreateTab("Главная", 4483362458)
    local F_CombatTab = FlightWindow:CreateTab("Аим / Бой", 4483362458)
    local F_UtilTab = FlightWindow:CreateTab("Утилиты / ТП", 4483362458)

    -- GOD MODE
    F_MainTab:CreateSection("Защита")
    local godModeEnabled = false
    F_MainTab:CreateToggle({ Name = "🛡️ God Mode (Восстановление HP)", CurrentValue = false,
        Callback = function(state) godModeEnabled = state end })

    RunService.Heartbeat:Connect(function()
        if godModeEnabled then
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health < hum.MaxHealth then
                    hum.Health = hum.MaxHealth
                end
            end
        end
    end)

    -- FLY
    F_MainTab:CreateSection("Полёт")
    local flyEnabled = false
    local flySpeed = 50
    local flyBV = nil

    F_MainTab:CreateSlider({ Name = "Скорость полёта", Range = {50, 500}, Increment = 10, CurrentValue = 50,
        Callback = function(v) flySpeed = v end })

    F_MainTab:CreateToggle({ Name = "Включить полёт", CurrentValue = false, Callback = function(state)
        flyEnabled = state
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        if state then
            flyBV = Instance.new("BodyVelocity")
            flyBV.Name = "FlyBV"
            flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            flyBV.Velocity = Vector3.new(0, 0, 0)
            flyBV.Parent = hrp
        else
            if flyBV then flyBV:Destroy() flyBV = nil end
            local bv = hrp:FindFirstChild("FlyBV")
            if bv then bv:Destroy() end
        end
    end })

    RunService.RenderStepped:Connect(function()
        if not flyEnabled then return end
        local char = LocalPlayer.Character
        local cam = workspace.CurrentCamera
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        if not flyBV or not flyBV.Parent then
            flyBV = Instance.new("BodyVelocity")
            flyBV.Name = "FlyBV"
            flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            flyBV.Parent = hrp
        end
        local move = hum.MoveDirection
        local camLook = cam.CFrame.LookVector
        flyBV.Velocity = camLook * move.Z * flySpeed + cam.CFrame.RightVector * move.X * flySpeed
    end)

    -- ВАКУУМ
    F_MainTab:CreateSection("Вакуум")
    local vacuumEnabled = false
    local vacuumRadius = 50

    F_MainTab:CreateSlider({ Name = "Радиус (до 1кк)", Range = {10, 1000000}, Increment = 100, CurrentValue = 50,
        Callback = function(v) vacuumRadius = v end })

    F_MainTab:CreateToggle({ Name = "Притягивать предметы", CurrentValue = false,
        Callback = function(state) vacuumEnabled = state end })

    RunService.Heartbeat:Connect(function()
        if not vacuumEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        for _, item in pairs(Workspace:GetDescendants()) do
            if (item:IsA("BasePart") or item:IsA("Model")) and item.Name ~= "Terrain" and item.Parent ~= char then
                local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
                if part then
                    local dist = (part.Position - hrp.Position).Magnitude
                    if dist <= vacuumRadius and dist > 3 then
                        item:RequestStreamAroundAsync(part.Position)
                        part.CFrame = part.CFrame:Lerp(CFrame.new(hrp.Position + Vector3.new(0, 2, 0)), 0.3)
                        part.Velocity = Vector3.new(0,0,0)
                    end
                end
            end
        end
    end)

    -- ТРИГГЕР-БОТ
    F_CombatTab:CreateSection("Триггер Бот")
    local triggerEnabled = false
    local triggerDelay = 0.1
    local triggerRange = 150

    F_CombatTab:CreateSlider({ Name = "Задержка выстрела (сек)", Range = {0.05, 1}, Increment = 0.05, CurrentValue = 0.1,
        Callback = function(v) triggerDelay = v end })

    F_CombatTab:CreateToggle({ Name = "🔫 Включить Триггер (Авто-стрельба)", CurrentValue = false,
        Callback = function(state)
            triggerEnabled = state
            if state then
                Rayfield:Notify({ Title = "Триггер", Content = "Включен! Наводись на зомби.", Duration = 3 })
            end
        end })

    local function checkCrosshair()
        local cam = workspace.CurrentCamera
        local rayOrigin = cam.CFrame.Position
        local rayDirection = cam.CFrame.LookVector * triggerRange

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {LocalPlayer.Character}

        local result = workspace:Raycast(rayOrigin, rayDirection, rayParams)
        if result and result.Instance then
            local parentModel = result.Instance:FindFirstAncestorOfClass("Model")
            if parentModel then
                local hum = parentModel:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(parentModel) then
                    return true
                end
            end
        end
        return false
    end

    local isShooting = false
    RunService.RenderStepped:Connect(function()
        if not triggerEnabled or isShooting then return end
        if checkCrosshair() then
            isShooting = true
            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildWhichIsA("Tool")
                if tool then tool:Activate() end
            end
            task.wait(triggerDelay)
            isShooting = false
        end
    end)

    -- ТП ПО КООРДИНАТАМ
    F_UtilTab:CreateSection("Телепорт по координатам")
    local tpX, tpY, tpZ = 0, 0, 0

    F_UtilTab:CreateInput({ Name = "Координата X", PlaceholderText = "0", RemoveTextAfterFocusLost = false, Callback = function(t) tpX = tonumber(t) or 0 end })
    F_UtilTab:CreateInput({ Name = "Координата Y", PlaceholderText = "50", RemoveTextAfterFocusLost = false, Callback = function(t) tpY = tonumber(t) or 0 end })
    F_UtilTab:CreateInput({ Name = "Координата Z", PlaceholderText = "0", RemoveTextAfterFocusLost = false, Callback = function(t) tpZ = tonumber(t) or 0 end })

    F_UtilTab:CreateButton({ Name = "Телепортироваться", Callback = function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(Vector3.new(tpX, tpY, tpZ))
            Rayfield:Notify({ Title = "ТП", Content = "Телепорт на "..tpX..", "..tpY..", "..tpZ, Duration = 3 })
        end
    end })
    
    -- FPS BOOST
    F_UtilTab:CreateSection("Буст ФПС (Графика)")
    local fpsBoostEnabled = false
    local originalLighting = {
        Brightness = Lighting.Brightness,
        ClockTime = Lighting.ClockTime,
        FogEnd = Lighting.FogEnd,
        FogStart = Lighting.FogStart,
    }

    F_UtilTab:CreateToggle({ Name = "Включить FPS Boost", CurrentValue = false, Callback = function(state)
        fpsBoostEnabled = state
        if state then
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.FogEnd = 100000
            Lighting.FogStart = 100000
            Lighting.GlobalShadows = false
            for _, obj in pairs(Lighting:GetChildren()) do
                if obj:IsA("BlurEffect") or obj:IsA("BloomEffect") or obj:IsA("SunRaysEffect") or obj:IsA("ColorCorrectionEffect") then
                    obj.Enabled = false
                end
            end
        else
            Lighting.Brightness = originalLighting.Brightness
            Lighting.ClockTime = originalLighting.ClockTime
            Lighting.FogEnd = originalLighting.FogEnd
            Lighting.FogStart = originalLighting.FogStart
            Lighting.GlobalShadows = true
        end
    end })
end
