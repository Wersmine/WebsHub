        local hrp = char:FindFirstChild("HumanoidRootPart") local hum = char:FindFirstChildOfClass("Humanoid") if not hrp or not hum then return end
        if not flyBV or not flyBV.Parent then flyBV = Instance.new("BodyVelocity") flyBV.Name = "FlyBV" flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6) flyBV.Parent = hrp end
        local move = hum.MoveDirection local camLook = cam.CFrame.LookVector flyBV.Velocity = camLook * move.Z * flySpeed + cam.CFrame.RightVector * move.X * flySpeed
    end)

    Main:CreateSection("Вакуум")
    local vacuumEnabled = false local vacuumRadius = 50
    Main:CreateSlider({ Name = "Радиус (до 1кк)", Range = {10, 1000000}, Increment = 100, CurrentValue = 50, Callback = function(v) vacuumRadius = v end })
    Main:CreateToggle({ Name = "Притягивать предметы", CurrentValue = false, Callback = function(state) vacuumEnabled = state end })
    RunService.Heartbeat:Connect(function()
        if not vacuumEnabled then return end
        local char = LocalPlayer.Character if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart") if not hrp then return end
        for _, item in pairs(Workspace:GetDescendants()) do
            if (item:IsA("BasePart") or item:IsA("Model")) and item.Name ~= "Terrain" and item.Parent ~= char then
                local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
                if part then local dist = (part.Position - hrp.Position).Magnitude if dist <= vacuumRadius and dist > 3 then item:RequestStreamAroundAsync(part.Position) part.CFrame = part.CFrame:Lerp(CFrame.new(hrp.Position + Vector3.new(0, 2, 0)), 0.3) part.Velocity = Vector3.new(0,0,0) end end
            end
        end
    end)

    Combat:CreateSection("Триггер Бот")
    local triggerEnabled = false local triggerDelay = 0.1 local triggerRange = 150
    Combat:CreateSlider({ Name = "Задержка (сек)", Range = {0.05, 1}, Increment = 0.05, CurrentValue = 0.1, Callback = function(v) triggerDelay = v end })
    Combat:CreateToggle({ Name = "🔫 Включить Триггер", CurrentValue = false, Callback = function(state) triggerEnabled = state end })
    local function checkCrosshair()
        local cam = workspace.CurrentCamera local rayOrigin = cam.CFrame.Position local rayDirection = cam.CFrame.LookVector * triggerRange
        local rayParams = RaycastParams.new() rayParams.FilterType = Enum.RaycastFilterType.Exclude rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
        local result = workspace:Raycast(rayOrigin, rayDirection, rayParams)
        if result and result.Instance then local parentModel = result.Instance:FindFirstAncestorOfClass("Model") if parentModel then local hum = parentModel:FindFirstChildOfClass("Humanoid") if hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(parentModel) then return true end end end
        return false
    end
    local isShooting = false
    RunService.RenderStepped:Connect(function()
        if not triggerEnabled or isShooting then return end
        if checkCrosshair() then isShooting = true local char = LocalPlayer.Character if char then local tool = char:FindFirstChildWhichIsA("Tool") if tool then tool:Activate() end end task.wait(triggerDelay) isShooting = false end
    end)

    Util:CreateSection("Телепорт по координатам")
    local tpX, tpY, tpZ = 0, 0, 0
    Util:CreateInput({ Name = "X", PlaceholderText = "0", RemoveTextAfterFocusLost = false, Callback = function(t) tpX = tonumber(t) or 0 end })
    Util:CreateInput({ Name = "Y", PlaceholderText = "50", RemoveTextAfterFocusLost = false, Callback = function(t) tpY = tonumber(t) or 0 end })
    Util:CreateInput({ Name = "Z", PlaceholderText = "0", RemoveTextAfterFocusLost = false, Callback = function(t) tpZ = tonumber(t) or 0 end })
    Util:CreateButton({ Name = "Телепортироваться", Callback = function()
        local char = LocalPlayer.Character if char and char:FindFirstChild("HumanoidRootPart") then char.HumanoidRootPart.CFrame = CFrame.new(Vector3.new(tpX, tpY, tpZ)) end
    end })
end

